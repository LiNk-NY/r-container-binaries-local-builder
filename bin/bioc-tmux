#!/usr/bin/env bash
# bioc-tmux - Run `bioc-build start` or `bioc-build run` in a detached tmux
# session, so the cycle keeps going after you log out. Output is also
# appended to a log file under $BIOC_BUILD_ROOT/tmux-logs/.
#
# Usage:
#   bioc-tmux [--detach] [--session NAME] start [start options] IMAGE
#   bioc-tmux [--detach] [--session NAME] run CYCLE_DIR
#
# From another machine:
#   ssh -t supermicro '~/r-container-binaries-local-builder/bin/bioc-tmux start IMAGE'

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
BUILD="${REPO_DIR}/bin/bioc-build"
BUILD_ROOT="${BIOC_BUILD_ROOT:-${HOME}/bioc-builds}"

# Settings passed through to bioc-build. A tmux server that is already
# running does not see this shell's environment, so they are written into
# the runner script instead.
PASS_VARS=(BIOC_BUILD_ROOT MAX_JOBS BUILD_TIMEOUT_SECONDS BUILD_ATTEMPTS
  BUILD_MEMORY_LIMIT BUILD_NCPUS BUILD_CPU_LIMIT BUILD_NICE BUILD_CPU_SHARES POLL_SECONDS
  DOCKER)

usage() {
  sed -n '2,/^$/{s/^# \{0,1\}//;p}' "${BASH_SOURCE[0]}"
}

die() { echo "bioc-tmux: $*" >&2; exit 1; }

# tmux session names cannot contain '.' or ':'.
session_name() {
  printf 'bioc-%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c '[:alnum:]-\n' '-' |
    tr -s '-' | sed 's/-$//'
}

detach=0
session=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --detach) detach=1; shift ;;
    --session) session="${2:?--session needs a name}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) break ;;
  esac
done

cmd="${1:-}"
case "${cmd}" in
  start|run) ;;
  "") usage >&2; exit 1 ;;
  *) die "only 'start' and 'run' need tmux; run 'bioc-build ${cmd}' directly" ;;
esac
[[ $# -ge 2 ]] || die "'${cmd}' needs an argument; see bioc-build --help"
command -v tmux >/dev/null || die "tmux is not installed"

# Name the session after the image (start) or the cycle directory (run).
if [[ -z "${session}" ]]; then
  last="${!#}"
  if [[ "${cmd}" == start ]]; then
    session="$(session_name "${last##*/}")"
  else
    session="$(session_name "$(basename "$(cd "${last}" 2>/dev/null && pwd || echo "${last}")")")"
  fi
fi

if tmux has-session -t "=${session}" 2>/dev/null; then
  die "tmux session '${session}' already exists; attach with: tmux attach -t ${session}"
fi

log_dir="${BUILD_ROOT}/tmux-logs"
mkdir -p "${log_dir}"
stamp="$(date '+%Y%m%d-%H%M%S')"
log="${log_dir}/${session}-${stamp}.log"
runner="${log_dir}/${session}-${stamp}.sh"

{
  echo '#!/usr/bin/env bash'
  for v in "${PASS_VARS[@]}"; do
    if [[ -n "${!v+set}" ]]; then
      printf 'export %s=%q\n' "${v}" "${!v}"
    fi
  done
  printf 'cd %q\n' "${REPO_DIR}"
  echo 'set -o pipefail'
  printf '%q ' "${BUILD}" "$@"
  printf '2>&1 | tee -a %q\n' "${log}"
  echo 'rc=$?'
  echo 'echo'
  # shellcheck disable=SC2016  # ${rc} expands in the runner, not here
  printf 'echo "bioc-build exited with status ${rc}. Log: %s"\n' "${log}"
  echo 'echo "Press Enter to close this window."'
  echo 'read -r'
} > "${runner}"

tmux new-session -d -s "${session}" -c "${REPO_DIR}" "bash $(printf '%q' "${runner}")"

echo "Started tmux session '${session}'"
echo "  Log:    ${log}"
echo "  Attach: tmux attach -t ${session}   (detach again with Ctrl-b d)"

if (( detach )) || [[ ! -t 1 ]]; then
  exit 0
fi
if [[ -n "${TMUX:-}" ]]; then
  exec tmux switch-client -t "${session}"
fi
exec tmux attach -t "${session}"
